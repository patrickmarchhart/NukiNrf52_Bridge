/*
 * Enables the DK's second UART (uart1) for the Loxone module machine
 * protocol (see nuki_uart_proto.c), using custom pinctrl instead of the
 * board's default "Arduino Serial" pins (P1.01/P1.02) - these were chosen
 * to match the pinout planned for the final custom Loxone-module PCB
 * (nRF52840 module), which doesn't use those pins. Neither pin has the
 * datasheet's "low frequency I/O only" restriction (unlike e.g. P0.29/
 * P0.31), so they're suitable for UART at normal baud rates.
 *
 *   P0.20 = TX (board transmits) -> wire to the Loxone module's RX
 *   P0.22 = RX (board receives)  -> wire to the Loxone module's TX
 * plus a common GND between the two boards.
 *
 * On the nRF52840 DK itself, P0.20/P0.22 are broken out on the "P0" GPIO
 * header (pins labelled 20 and 22) - not the Arduino shield connector.
 */

&pinctrl {
	uart1_default: uart1_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 20)>;
		};
		group2 {
			psels = <NRF_PSEL(UART_RX, 0, 22)>;
			bias-pull-up;
		};
	};

	uart1_sleep: uart1_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 20)>,
				<NRF_PSEL(UART_RX, 0, 22)>;
			low-power-enable;
		};
	};
};

&uart1 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart1_default>;
	pinctrl-1 = <&uart1_sleep>;
	pinctrl-names = "default", "sleep";
};
