/*
 * Enables the DK's second UART (uart1) for the Loxone module machine
 * protocol (see nuki_uart_proto.c).
 *
 * Uses the board's own default "Arduino Serial" pins for uart1 - P1.01 (RX)
 * and P1.02 (TX) - instead of custom pinctrl. An earlier revision of this
 * overlay moved uart1 to P0.20/P0.22 (planned to match the final custom
 * Loxone-module PCB's pinout), but those turned out to be hard-wired on the
 * DK to the onboard QSPI flash chip's IO0/IO2 lines (P0.17/19-23), which
 * caused unreliable/no communication on uart1. P1.01/P1.02 aren't connected
 * to any onboard peripheral, so switched back to them for reliable testing
 * on this DK - the final custom PCB (no onboard QSPI flash) can use whatever
 * pins fit its own layout without this constraint.
 *
 *   P1.02 = TX (board transmits) -> wire to the Loxone module's RX
 *   P1.01 = RX (board receives)  -> wire to the Loxone module's TX
 * plus a common GND between the two boards.
 *
 * On the nRF52840 DK itself, P1.01/P1.02 are broken out on the Arduino
 * shield connector as D0/D1.
 */

&uart1 {
	status = "okay";
	current-speed = <115200>;
};

/*
 * The DK's onboard QSPI flash chip (MX25R6435F) is hard-wired to P0.17/19-23.
 * This project doesn't use the external flash (settings/NVS use internal
 * flash), so disable the QSPI peripheral - harmless either way now that
 * uart1 no longer shares any of those pins, but no reason to leave an
 * unused peripheral active.
 */
&qspi {
	status = "disabled";
};
